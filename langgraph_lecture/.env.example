# Скопируйте этот файл в .env и впишите свой ключ OpenRouter.
# Получить ключ: https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-...

# Необязательно: какую модель использовать (формат "провайдер/модель").
# Полный список моделей: https://openrouter.ai/models
# Если не задать -- используется DEFAULT_MODEL из common/llm.py.
#
# Несколько примеров на выбор:
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_MODEL=google/gemini-2.5-pro
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Необязательно: для атрибуции приложения в статистике OpenRouter, на
# работу примеров не влияет.
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=LangGraph Lecture
